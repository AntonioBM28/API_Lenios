# ==========================================
# Leños Rellenos API – Variables de entorno
# Copia este archivo como .env y rellena los valores
# NUNCA subas .env al repositorio
# ==========================================

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos Supabase (conexión directa a Postgres)
SUPABASE_DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-super-secret-password
SUPABASE_DB_NAME=postgres

# Supabase requiere SSL (default true). Solo se pone en "false" para el
# Postgres local de docker-compose (ver docker-compose.yml), que no tiene
# SSL configurado. No tocar este valor si usas Supabase.
DB_SSL=true

# Cliente Supabase (para storage, auth y realtime futuros)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Número de WhatsApp del negocio (formato E.164 sin "+", ej. 5215512345678)
# usado para armar la URL wa.me al confirmar un pedido (RF3/RF4)
WHATSAPP_BUSINESS_NUMBER=5215500000000

# Acceso simple del panel admin (RF8) — un único PIN, sin usuarios ni roles.
# NUNCA se guarda el PIN en texto plano: se guarda su HASH bcrypt.
#
# Genera el hash de tu propio PIN con:
#   npm run hash:pin -- <tu-pin>
#
# Ejemplo de salida para el PIN "1234" (NO uses este PIN en producción,
# es solo una referencia de formato — genera el tuyo con el comando de arriba):
#   ADMIN_ACCESS_CODE_HASH=$2b$12$7Sauaw4Rd9FiHTGxhsvZou7Znvl63bs0RupRvsJaQMZewbkegm7Fi
ADMIN_ACCESS_CODE_HASH=$2b$12$7Sauaw4Rd9FiHTGxhsvZou7Znvl63bs0RupRvsJaQMZewbkegm7Fi

# Secreto para firmar los JWT de sesión del admin. En producción usa un valor
# largo y aleatorio (ej. `openssl rand -hex 32`), nunca reutilices este ejemplo.
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ADMIN_EXPIRATION=12h

# Origen del frontend en producción (usado por CORS en main.ts).
# Solo obligatorio cuando NODE_ENV=production; en development CORS acepta '*'.
FRONTEND_URL=https://tu-dominio-de-produccion.com

# Groq (https://console.groq.com/keys) — API de LLM gratuita compatible con
# OpenAI, sin tarjeta requerida. Usada por el módulo `ai` (buscador
# inteligente del menú + "Sugerencia del Chef" en el sitio público).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
